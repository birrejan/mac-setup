# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Local, machine-specific or secret files that must never be committed
.gitconfig.local
*.local
# ...except the Stow package for ~/.local/bin, which is not a local override
!dotfiles/bin/.local/
*.bak
*.bak-*

# Editor / tooling noise
*.swp
*~

# Built on demand by the sketchybar capture plugin from capture_state.swift
dotfiles/sketchybar/.config/sketchybar/bin/capture_state
