#!/bin/bash

source "$CONFIG_DIR/colors.sh"
PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

sketchybar --add event aerospace_workspace_change

# Keep the existing height and display policy so window clearance stays correct.
sketchybar --bar display=main \
  hidden=off position=top height=37 sticky=off \
  color="$BAR_COLOR" blur_radius=20 shadow=off \
  border_width=1 border_color="$BORDER_COLOR" \
  padding_left=14 padding_right=14 font_smoothing=on

# Ordinary information sits directly on the bar. Only focus and alerts get a
# surface, with consistent type, spacing and corner radius.
sketchybar --default \
  icon.font="$TEXT_FONT:Regular:13.0" icon.color="$MUTED_COLOR" \
  label.font="$MONO_FONT:Medium:12.0" label.color="$WHITE" \
  background.color="$ITEM_BG_COLOR" \
  background.corner_radius=5 background.height=23 \
  background.border_width=0 background.border_color="$BORDER_COLOR" \
  padding_left=5 padding_right=5 \
  icon.padding_left=7 icon.padding_right=5 \
  label.padding_left=0 label.padding_right=7 background.drawing=off

source "$ITEM_DIR/spaces.sh"
source "$ITEM_DIR/media.sh"
source "$ITEM_DIR/calendar.sh"
source "$ITEM_DIR/volume.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/cpu.sh"
source "$ITEM_DIR/memory.sh"
source "$ITEM_DIR/capture.sh"
source "$ITEM_DIR/controls.sh"

# Place the conditional RAM and capture indicators safely around camera notches.
source "$ITEM_DIR/notch.sh"
sketchybar --update
